# Node Environment
NODE_ENV=production

# Timezone
TZ=UTC

# Example Application Options
# Set to "true" to use pairing code instead of QR code
USE_PAIRING_CODE=false

# Set to "true" to enable auto-replies to incoming messages
DO_REPLIES=false

# Optional: Phone number for pairing code (without +, -, or ())
# Only used if USE_PAIRING_CODE=true
# PHONE_NUMBER=1234567890

# Optional: API Configuration (for future API implementation)
# API_PORT=3000
# API_HOST=0.0.0.0
